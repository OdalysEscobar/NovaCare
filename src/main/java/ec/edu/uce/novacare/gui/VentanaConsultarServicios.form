<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="ec.edu.uce.novacare.gui.VentanaConsultarServicios">
  <grid id="27dc6" binding="panelPrincipal" layout-manager="GridBagLayout">
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties>
      <background color="-1512193"/>
    </properties>
    <border type="none"/>
    <children>
      <component id="3aff3" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag weightx="1.0" weighty="0.0"/>
        </constraints>
        <properties>
          <font name="Arial Rounded MT Bold" size="16"/>
          <text value="Catálogo de servicios"/>
        </properties>
      </component>
      <scrollpane id="82f3f">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
          <gridbag weightx="0.0" weighty="0.0"/>
        </constraints>
        <properties>
          <background color="-65581"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="74a0f" class="javax.swing.JTable" binding="tablaServicios">
            <constraints/>
            <properties/>
          </component>
        </children>
      </scrollpane>
      <component id="79797" class="javax.swing.JButton" binding="regresarButton" default-binding="true">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag weightx="0.0" weighty="0.0"/>
        </constraints>
        <properties>
          <background color="-2768917"/>
          <enabled value="true"/>
          <font size="16"/>
          <text value="Regresar"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
